{
  "schema_version": 1,
  "application": {
    "name": "Projet Sauvegarde",
    "environment": "development",
    "language": "system",
    "supported_languages": [
      "fr",
      "en"
    ]
  },
  "development": {
    "sandbox_root": ".local/sandbox",
    "allow_only_sandbox_paths": true,
    "simulate_by_default": true,
    "allow_scheduled_runs": false,
    "allow_volume_triggers": false
  },
  "backup_defaults": {
    "verify_after_copy": "checksum",
    "retain_successful_versions": 10,
    "preserve_latest_successful": true,
    "require_confirmation_before_deletion": true,
    "restore_to_new_location_by_default": true
  },
  "diagnostics": {
    "level": "info",
    "directory": ".local/logs",
    "redact_personal_paths": true
  },
  "storage": {
    "state_directory": ".local/state"
  }
}
